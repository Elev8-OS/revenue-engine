# Names only. Values belong in Railway variables, never in this file, a commit or a log.
DATABASE_URL=
PUBLIC_BASE_URL=            # e.g. https://revenue-engine-production-3ed5.up.railway.app
SEED_DEMO=                  # true seeds the labelled demo portfolio; unset removes it

# Access, way in #1: single sign-on with the Elev8-Suite Microsoft 365 tenant.
# Setting the two ENTRA_* values (plus PUBLIC_BASE_URL) closes the gate AND
# retires the magic link below. The tenant id is public — it resolves from the
# domain name — so it has a built-in default and this stays empty.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=            # Application (client) ID of the app registration
ENTRA_CLIENT_SECRET=        # the client secret VALUE, not its ID

# Who among them may open this tool. EVERY gate set below applies, so adding one
# can only narrow access, never widen it. With both empty, anyone in the tenant
# gets in — closed, but wide.

# Preferred gate: Entra group OBJECT IDs, comma-separated. Access then ends when
# somebody leaves the group in the directory, rather than when a person remembers
# to edit this variable. Object ids, not display names: a name is mutable and
# reusable, so a rename would silently lock everyone out.
# Requires one step in the app registration — Token configuration -> add the
# `groups` claim (Security groups). Without it NOBODY gets in, and the sign-in
# page says exactly that rather than blaming the person.
ALLOWED_GROUPS=

# Exact addresses. Useful before the group exists, or to narrow further.
ALLOWED_EMAILS=

# Access, way in #2: the mail fallback. It stands only while single sign-on does
# not, unless MAGIC_LINK=true asks for it explicitly. With neither configured the
# dashboard is OPEN to anyone with the URL, and the page says so in a banner.
MAGIC_LINK=
MAIL_MODE=log               # log | resend. log prints the link to the deploy log,
                            # which means anyone who can read logs can sign in.
RESEND_API_KEY=
MAIL_FROM=

ELEV8_API_BASE=
ELEV8_API_TOKEN=
PRICELABS_API_KEY=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=     # you invent this one — Channex does not sign its webhooks

# MyDataValue. Names deliberately match the mydatavalue-mcp service.
MDV_BASE_URL=https://app.mydatavalue.com/api/v1
MDV_CLIENT_ID=
MDV_CLIENT_SECRET=
# Seed only, and it must come from a FRESH authorisation for this service.
# Never copy the seed token from mydatavalue-mcp: that grant's refresh token has
# already been rotated, so presenting it revokes the grant and takes that service
# down with this one. Client id and secret may be shared; the token chain may not.
MDV_SEED_REFRESH_TOKEN=

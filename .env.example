# Names only. Values belong in Railway variables, never in this file, a commit or a log.
DATABASE_URL=
PUBLIC_BASE_URL=            # e.g. https://revenue-engine-production-3ed5.up.railway.app
SEED_DEMO=                  # true seeds the labelled demo portfolio; unset removes it

# Access. Leave ALLOWED_EMAILS empty and the dashboard is OPEN to anyone with the
# URL — the page says so in a banner. Set it and the magic-link gate closes.
ALLOWED_EMAILS=
MAIL_MODE=log               # log | resend. log prints the link to the deploy log,
                            # which means anyone who can read logs can sign in.
RESEND_API_KEY=
MAIL_FROM=

ELEV8_API_BASE=
ELEV8_API_TOKEN=
PRICELABS_API_KEY=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=     # you invent this one — Channex does not sign its webhooks

# MyDataValue. Names deliberately match the mydatavalue-mcp service.
MDV_BASE_URL=https://app.mydatavalue.com/api/v1
MDV_CLIENT_ID=
MDV_CLIENT_SECRET=
# Seed only, and it must come from a FRESH authorisation for this service.
# Never copy the seed token from mydatavalue-mcp: that grant's refresh token has
# already been rotated, so presenting it revokes the grant and takes that service
# down with this one. Client id and secret may be shared; the token chain may not.
MDV_SEED_REFRESH_TOKEN=
